# Copy to .env.local. Never commit credentials, authorization codes, or tokens.
# Local: http://localhost:3000
# Production: exact Vercel HTTPS origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NamoID Console > Test environment > Applications > AgentGate.
# Use a server-rendered application. These values must remain server-only.
NAMOID_CLIENT_ID=
NAMOID_CLIENT_SECRET=

# Turso/libSQL. Omit both for local file:agentgate.db development.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
